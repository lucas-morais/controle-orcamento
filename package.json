{
   "name": "controle-orcamento",
   "version": "0.0.1",
   "description": "Awesome project developed with TypeORM.",
   "type": "commonjs",
   "engines": {
      "node": ">=20.11.10"
   },
   "devDependencies": {
      "@eslint/js": "^9.5.0",
      "@types/express": "^4.17.21",
      "@types/node": "^16.18.101",
      "@typescript-eslint/eslint-plugin": "^7.13.1",
      "@typescript-eslint/parser": "^7.13.1",
      "eslint": "^9.5.0",
      "globals": "^15.6.0",
      "ts-node": "10.9.1",
      "ts-node-dev": "^2.0.0",
      "typescript": "^4.7.4",
      "typescript-eslint": "^7.13.1"
   },
   "dependencies": {
      "dotenv": "^16.4.5",
      "express": "^4.19.2",
      "pg": "^8.4.0",
      "reflect-metadata": "^0.1.13",
      "typeorm": "0.3.20"
   },
   "scripts": {
      "build": "tsc",
      "start": "npm run build && node build/index.ts",
      "dev": "tsnd --respawn --transpile-only src/index.ts",
      "typeorm": "typeorm-ts-node-commonjs",
      "typeorm:migrate": "npm run -- typeorm migration:run -d src/data-source.ts",
      "typeorm:revert": "npm run -- typeorm migration:revert -d src/data-source.ts",
      "typeorm:generate": "npm run -- typeorm migration:generate -d src/data-source.ts",
      "typeorm:create": "npm run typeorm migration:create -- -n",
      "lint": "eslint 'src/**/*.{js,ts}'",
      "lint:fix": "eslint 'src/**/*.{js,ts}' --fix"
   }
}
